# Copy to .env (gitignored) and adjust. Every value has a safe local default in compose.yaml,
# so `docker compose up` also works without a .env file. Local development credentials only.

POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-me-local-only

# Host ports (change if they clash with something already running locally)
API_PORT=8080
SCHEDULER_PORT=8081
# A range so `docker compose up -d --scale worker-service=3` does not collide
WORKER_PORT_RANGE=8082-8084
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9094
REDIS_HOST_PORT=6379
PROMETHEUS_PORT=9090

# Scheduling / execution tuning
SCHEDULER_MAX_IN_FLIGHT=8
WORKER_CONCURRENCY=2
# Kafka partitions per topic: caps total parallel consumers across all worker instances
KAFKA_TOPIC_PARTITIONS=6
WORKER_TASK_TIMEOUT=20s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
ORCHESTRATOR_RETRY_INITIAL_DELAY=1s
ORCHESTRATOR_RETRY_MAX_DELAY=8s

# Console log format: ecs | logstash | gelf (structured JSON, includes MDC jobId)
LOG_FORMAT=ecs
